# Copia estas variables en Render (Environment) o en un archivo .env si lo corres en tu PC.
PORT=8787
ALLOWED_ORIGINS=https://bibliopub.netlify.app
ALLOWED_EMAIL=brandonsimanca@gmail.com
FIREBASE_PROJECT_ID=bibliopub-854f4
# Enlace de tu carpeta de libros en MEGA (el mismo que pegaste en la app)
MEGA_FOLDER_URL=https://mega.nz/folder/XXXX#CLAVE
# Opcional: descargar con tu cuenta de MEGA (usa la cuota de tu plan, no la anónima)
MEGA_EMAIL=
MEGA_PASSWORD=
# Opcional: para que también funcione con visitantes aprobados (JSON de la cuenta de servicio de Firebase, en una sola línea)
FIREBASE_SERVICE_ACCOUNT=
# Caché en disco
CACHE_DIR=./cache
CACHE_MAX_MB=1500
MAX_DOWNLOADS=3
